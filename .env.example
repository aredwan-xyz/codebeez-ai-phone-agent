# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="AI Phone Agent"
DEBUG=false
HOST=0.0.0.0
PORT=8000
BASE_URL=https://your-ngrok-or-domain.com   # public URL for Twilio webhooks
ADMIN_API_KEY=
# Outbound calls, SMS and transfers fail closed until both options are configured.
OUTBOUND_ENABLED=false
OUTBOUND_ALLOWED_NUMBERS=[]

# ── Telephony (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# ── STT (Deepgram) ───────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# ── TTS (ElevenLabs) ─────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM    # Rachel — swap for your custom voice
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5        # lowest latency model

# ── LLM (Anthropic) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_phone_agent

# ── Agent Persona ─────────────────────────────────────────────────────────────
AGENT_NAME=Aria
AGENT_COMPANY=Acme Corp
AGENT_TIMEZONE=America/New_York

# ── Google Calendar (optional) ───────────────────────────────────────────────
GOOGLE_CREDENTIALS_PATH=./credentials/google_service_account.json
GOOGLE_CALENDAR_ID=primary

# ── HubSpot CRM (optional) ───────────────────────────────────────────────────
HUBSPOT_API_KEY=your_hubspot_private_app_token

# ── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
